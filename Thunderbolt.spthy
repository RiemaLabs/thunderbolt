theory Thunderbolt begin

// Basic cryptographic primitives
builtins: signing, hashing, asymmetric-encryption

// Functions and constants used in the protocol
functions: Alice/0, Bob/0, Carol/0, Cmte/0, 
           FinalizationSuccess/1, Finalized/1,
           Locked/1, Prepared/1, 
           SetupCommittee/0, 
           Spent/1, TransferEvent/3, 
           TweakFor/3, UTXO/1,
           CommitteeApproved/2, TransferFinalized/2,
           ApprovedTransfer/2,
           ValidSignature/1, HasTweakSecret/1, TweakedSig/2,
           OwnerState/3 

// Protocol rules
rule SetupThunderbolt:
   [ Fr(~committee) ]
  --[ SetupCommittee() ]->
   [ !Committee(~committee) ]

rule PrepareUTXO:
   [ Fr(~id) ]
  --[ Prepared(~id) ]->
   [ Locked(~id), !OwnerState(Alice, ~id, 'Pending'), !UTXO(~id) ]

rule GenerateTweaks:
   [ Fr(~tAB), Fr(~tKB), Fr(~tBC), Fr(~tKC) ]
  -->
   [ !TweakFor(Alice, Bob, ~tAB), !TweakFor(Cmte, Bob, ~tKB),
     !TweakFor(Bob, Carol, ~tBC), !TweakFor(Cmte, Carol, ~tKC) ]

rule Transfer:
   [ !OwnerState(sender, id, 'Approved'), 
     !TweakFor(sender, receiver, t_sr), !TweakFor(Cmte, receiver, t_cr),
     Fr(~sig), !UTXO(id) ]
  --[ TransferEvent(sender, receiver, id), TweakedSig(receiver, ~sig),
      ValidSignature(~sig), HasTweakSecret(receiver) ]->
   [ !OwnerState(receiver, id, 'Pending'), Out(<receiver, ~sig>) ]

// Committee approves a transfer
rule CommitteeApproval:
   [ !Committee(committee), !UTXO(id), !OwnerState(u, id, 'Pending'), Fr(~approval) ]
  --[ CommitteeApproved(id, u) ]->
   [ !OwnerState(u, id, 'Approved') ]

// Finalize the transfer with committee approval
rule Finalize:
   [ !OwnerState(u, id, 'Approved'), Locked(id) ]
  --[ Finalized(id), FinalizationSuccess(id), TransferFinalized(u, id) ]->
   [ Spent(id) ]

// Security lemmas

// Ensure that a UTXO can only be spent once

lemma OneTimeSpendability:
  all-traces
  "∀ utxo #i #j.
         ((Finalized( utxo ) @ #i) ∧ (Finalized( utxo ) @ #j)) ⇒
         (#i = #j)"
simplify
solve( (#i < #j) ∥ (#j < #i) )
  case case_1
  solve( !OwnerState( u, utxo, 'Approved' ) ▶₀ #i )
    case CommitteeApproval_case_1
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_2
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_3
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_4
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_5
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !OwnerState( u, utxo, 'Approved' ) ▶₀ #i )
    case CommitteeApproval_case_1
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_2
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_3
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_4
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_5
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma OwnershipTransfer:
  all-traces
  "∀ sender receiver id #i.
         (TransferEvent( sender, receiver, id ) @ #i) ⇒
         (∃ sig. TweakedSig( receiver, sig ) @ #i)"
simplify
by contradiction /* from formulas */

lemma OwnershipSoundness:
  all-traces
  "∀ sig #i.
         (ValidSignature( sig ) @ #i) ⇒
         (∃ u #j. HasTweakSecret( u ) @ #j)"
simplify
by contradiction /* from formulas */

lemma Unforgeability:
  all-traces
  "∀ sig #i.
         (ValidSignature( sig ) @ #i) ⇒
         (∃ u #j #k.
           (TweakedSig( u, sig ) @ #j) ∧ (HasTweakSecret( u ) @ #k))"
simplify
by contradiction /* from formulas */

lemma CommitteeAuthorizationRequired:
  all-traces
  "∀ id u #i.
         (TransferFinalized( u, id ) @ #i) ⇒
         (∃ #j. (#j < #i) ∧ (CommitteeApproved( id, u ) @ #j))"
simplify
solve( !OwnerState( u, id, 'Approved' ) ▶₀ #i )
  case CommitteeApproval_case_1
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_2
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_3
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_4
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_5
  by contradiction /* from formulas */
qed

lemma canFinalize:
  exists-trace
  "∃ id #i #j #k #l.
         ((((((Prepared( id ) @ #i) ∧
              (TransferEvent( Alice, Bob, id ) @ #j)) ∧
             (CommitteeApproved( id, Bob ) @ #k)) ∧
            (Finalized( id ) @ #l)) ∧
           (#i < #j)) ∧
          (#j < #k)) ∧
         (#k < #l)"
simplify
solve( !TweakFor( Alice, Bob, t_sr ) ▶₁ #j )
  case GenerateTweaks
  solve( !TweakFor( Cmte, Bob, t_cr ) ▶₂ #j )
    case GenerateTweaks
    solve( !UTXO( ~id ) ▶₄ #j )
      case PrepareUTXO
      solve( !Committee( committee ) ▶₀ #k )
        case SetupThunderbolt
        solve( !UTXO( ~id ) ▶₁ #k )
          case PrepareUTXO
          solve( !OwnerState( Bob, ~id, 'Pending' ) ▶₂ #k )
            case Transfer_case_1
            solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #l )
              case CommitteeApproval_case_1
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma transferCompletionPossible:
  exists-trace
  "∃ id #i #j #k #l.
         ((((((Prepared( id ) @ #i) ∧
              (CommitteeApproved( id, Alice ) @ #j)) ∧
             (TransferEvent( Alice, Bob, id ) @ #k)) ∧
            (Finalized( id ) @ #l)) ∧
           (#i < #j)) ∧
          (#j < #k)) ∧
         (#k < #l)"
simplify
solve( !Committee( committee ) ▶₀ #j )
  case SetupThunderbolt
  solve( !UTXO( ~id ) ▶₁ #j )
    case PrepareUTXO
    solve( !OwnerState( Alice, ~id, 'Pending' ) ▶₂ #j )
      case PrepareUTXO
      solve( !TweakFor( Alice, Bob, t_sr ) ▶₁ #k )
        case GenerateTweaks
        solve( !TweakFor( Cmte, Bob, t_cr ) ▶₂ #k )
          case GenerateTweaks
          solve( !UTXO( ~id ) ▶₄ #k )
            case PrepareUTXO
            solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #l )
              case CommitteeApproval_case_1
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #k )
                  case CommitteeApproval
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma finalizationSuccessPossible:
  exists-trace
  "∃ id #i #j #k #l.
         ((((((Prepared( id ) @ #i) ∧
              (TransferEvent( Alice, Bob, id ) @ #j)) ∧
             (CommitteeApproved( id, Bob ) @ #k)) ∧
            (FinalizationSuccess( id ) @ #l)) ∧
           (#i < #j)) ∧
          (#j < #k)) ∧
         (#k < #l)"
simplify
solve( !TweakFor( Alice, Bob, t_sr ) ▶₁ #j )
  case GenerateTweaks
  solve( !TweakFor( Cmte, Bob, t_cr ) ▶₂ #j )
    case GenerateTweaks
    solve( !UTXO( ~id ) ▶₄ #j )
      case PrepareUTXO
      solve( !Committee( committee ) ▶₀ #k )
        case SetupThunderbolt
        solve( !UTXO( ~id ) ▶₁ #k )
          case PrepareUTXO
          solve( !OwnerState( Bob, ~id, 'Pending' ) ▶₂ #k )
            case Transfer_case_1
            solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #l )
              case CommitteeApproval_case_1
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

end