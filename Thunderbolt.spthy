theory Thunderbolt begin

// Basic cryptographic primitives
builtins: signing, hashing, asymmetric-encryption

// Functions and constants used in the protocol
functions: Alice/0, Bob/0, Carol/0, Cmte/0, 
           FinalizationSuccess/1, Finalized/1,
           HasTweakedSig/2, 
           Locked/1, Owner/2, Prepared/1, 
           SetupCommittee/0, 
           Spent/1, TransferEvent/3, Transferred/3, 
           TweakFor/3, TweakedSig/2, UTXO/1,
           CommitteeApproved/2, TransferFinalized/2

// Protocol rules
rule SetupThunderbolt:
   [ Fr(~committee) ]
  --[ SetupCommittee() ]->
   [ !Committee(~committee) ]

rule PrepareUTXO:
   [ Fr(~id) ]
  --[ Prepared(~id) ]->
   [ Locked(~id), !Owner(Alice, ~id), !UTXO(~id) ]

rule GenerateTweaks:
   [ Fr(~tAB), Fr(~tKB), Fr(~tBC), Fr(~tKC) ]
  -->
   [ !TweakFor(Alice, Bob, ~tAB), !TweakFor(Cmte, Bob, ~tKB),
     !TweakFor(Bob, Carol, ~tBC), !TweakFor(Cmte, Carol, ~tKC) ]

// Transfer from Alice to Bob with committee involvement
rule Transfer:
   [ !Owner(Alice, id), 
     !TweakFor(Alice, Bob, tAB), !TweakFor(Cmte, Bob, tKB),
     Fr(~sig), !UTXO(id) ]
  --[ Transferred(Alice, Bob, id), HasTweakedSig(Bob, ~sig),
      TransferEvent(Alice, Bob, id), TweakedSig(Bob, ~sig),
      ValidSignature(~sig), HasTweakSecret(Bob) ]->
   [ !Owner(Bob, id), Out(<Bob, ~sig>), PendingApproval(id, Bob) ]

// Reassign from Bob to Carol with committee involvement
rule Reassign:
   [ !Owner(Bob, id), 
     !TweakFor(Bob, Carol, tBC), !TweakFor(Cmte, Carol, tKC),
     Fr(~sig) ]
  --[ Transferred(Bob, Carol, id), HasTweakedSig(Carol, ~sig),
      TransferEvent(Bob, Carol, id), TweakedSig(Carol, ~sig),
      ValidSignature(~sig), HasTweakSecret(Carol) ]->
   [ !Owner(Carol, id), Out(<Carol, ~sig>), PendingApproval(id, Carol) ]

// Committee approves a transfer
rule CommitteeApproval:
   [ !Committee(committee), !UTXO(id), PendingApproval(id, u), Fr(~approval) ]
  --[ CommitteeApproved(id, u) ]->
   [ ApprovedTransfer(id, u) ]

// Finalize the transfer with committee approval
rule Finalize:
   [ !Owner(u, id), Locked(id), ApprovedTransfer(id, u) ]
  --[ Finalized(id), FinalizationSuccess(id), TransferFinalized(u, id) ]->
   [ Spent(id) ]

// Security lemmas

// Ensure that a UTXO can only be spent once
lemma OneTimeSpendability:
  all-traces
  "∀ utxo #i #j.
    (Finalized(utxo) @ #i) ∧ (Finalized(utxo) @ #j) ⇒ (#i = #j)"

// When a transfer occurs, the receiver should obtain a tweaked signature
lemma OwnershipTransfer:
  all-traces
  "∀ sender receiver u #i.
    Transferred(sender, receiver, u) @ #i
    ⇒ ∃ sig. HasTweakedSig(receiver, sig) @ #i"

// UTXOs can only be spent with proper authorization
lemma SpendAuthorization:
  all-traces
  "∀ a b id #i.
    Transferred(a, b, id) @ #i
    ⇒ ∃ twe. HasTweakedSig(b, twe) @ #i"

// Only the intended recipient who knows the correct tweak secrets can recover a valid signature from a tweaked signature
lemma OwnershipSoundness:
  all-traces
  "∀ sig #i.
    ValidSignature(sig) @ #i
    ⇒ ∃ u #j. HasTweakSecret(u) @ #j"

// Signature unforgeability
lemma Unforgeability:
  all-traces
  "∀ sig #i.
    ValidSignature(sig) @ #i
    ⇒ ∃ u #j #k. 
       TweakedSig(u, sig) @ #j ∧ 
       HasTweakSecret(u) @ #k"

// Committee involvement is required for finalization
lemma CommitteeAuthorizationRequired:
  all-traces
  "∀ id u #i.
    TransferFinalized(u, id) @ #i
    ⇒ ∃ #j. (#j < #i) ∧ CommitteeApproved(id, u) @ #j"
      
// Existence lemmas

// There exists a trace where a transfer event can lead to finalization
lemma canFinalize:
  exists-trace
  "∃ id #i #j #k #l.
    Prepared(id) @ #i ∧
    TransferEvent(Alice, Bob, id) @ #j ∧
    CommitteeApproved(id, Bob) @ #k ∧
    Finalized(id) @ #l ∧
    #i < #j ∧ #j < #k ∧ #k < #l"

// There exists a trace where a transfer can be successfully completed
lemma transferCompletionPossible:
  exists-trace
  "∃ id #i #j #k.
    Prepared(id) @ #i ∧
    Transferred(Alice, Bob, id) @ #j ∧ 
    Finalized(id) @ #k ∧
    #i < #j ∧ #j < #k"

// There exists a trace where a UTXO can be successfully finalized
lemma finalizationSuccessPossible:
  exists-trace
  "∃ id #i #j #k #l.
    Prepared(id) @ #i ∧ 
    TransferEvent(Alice, Bob, id) @ #j ∧
    CommitteeApproved(id, Bob) @ #k ∧
    FinalizationSuccess(id) @ #l ∧
    #i < #j ∧ #j < #k ∧ #k < #l"

end