theory Thunderbolt begin

// Function signature and definition of the equational theory E

functions: Alice/0, ApprovedTransfer/2, Bob/0, Carol/0, Cmte/0,
           CommitteeApproved/2, FinalizationSuccess/1, Finalized/1,
           HasTweakedSig/2, Locked/1, Owner/2, PendingApproval/2, Prepared/1,
           SetupCommittee/0, Spent/1, TransferEvent/3, TransferFinalized/2,
           Transferred/3, TweakFor/3, TweakedSig/2, UTXO/1, adec/2, aenc/2,
           fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true











rule (modulo E) SetupThunderbolt:
   [ Fr( ~committee ) ]
  --[ SetupCommittee( ) ]->
   [ !Committee( ~committee ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) PrepareUTXO:
   [ Fr( ~id ) ]
  --[ Prepared( ~id ) ]->
   [
   Locked( ~id ), !Owner( Alice, ~id ), !UTXO( ~id ),
   PendingApproval( ~id, Alice )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenerateTweaks:
   [ Fr( ~tAB ), Fr( ~tKB ), Fr( ~tBC ), Fr( ~tKC ) ]
  -->
   [
   !TweakFor( Alice, Bob, ~tAB ), !TweakFor( Cmte, Bob, ~tKB ),
   !TweakFor( Bob, Carol, ~tBC ), !TweakFor( Cmte, Carol, ~tKC )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Transfer:
   [
   !Owner( Alice, id ), !TweakFor( Alice, Bob, tAB ),
   !TweakFor( Cmte, Bob, tKB ), Fr( ~sig ), !UTXO( id )
   ]
  --[
  Transferred( Alice, Bob, id ), HasTweakedSig( Bob, ~sig ),
  TransferEvent( Alice, Bob, id ), TweakedSig( Bob, ~sig ),
  ValidSignature( ~sig ), HasTweakSecret( Bob )
  ]->
   [ !Owner( Bob, id ), Out( <Bob, ~sig> ), PendingApproval( id, Bob )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reassign:
   [
   !Owner( Bob, id ), !TweakFor( Bob, Carol, tBC ),
   !TweakFor( Cmte, Carol, tKC ), Fr( ~sig )
   ]
  --[
  Transferred( Bob, Carol, id ), HasTweakedSig( Carol, ~sig ),
  TransferEvent( Bob, Carol, id ), TweakedSig( Carol, ~sig ),
  ValidSignature( ~sig ), HasTweakSecret( Carol )
  ]->
   [
   !Owner( Carol, id ), Out( <Carol, ~sig> ),
   PendingApproval( id, Carol )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CommitteeApproval:
   [
   !Committee( committee ), !UTXO( id ), PendingApproval( id, u ),
   Fr( ~approval )
   ]
  --[ CommitteeApproved( id, u ) ]->
   [ ApprovedTransfer( id, u ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Finalize:
   [ !Owner( u, id ), Locked( id ), ApprovedTransfer( id, u ) ]
  --[
  Finalized( id ), FinalizationSuccess( id ),
  TransferFinalized( u, id )
  ]->
   [ Spent( id ) ]

  /* has exactly the trivial AC variant */

lemma OneTimeSpendability:
  all-traces
  "∀ utxo #i #j.
    ((Finalized( utxo ) @ #i) ∧ (Finalized( utxo ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ utxo #i #j.
  (Finalized( utxo ) @ #i) ∧ (Finalized( utxo ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !Owner( u, utxo ) ▶₀ #i )
    case PrepareUTXO
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( ApprovedTransfer( ~id, Alice ) ▶₂ #i )
        case CommitteeApproval
        solve( !Owner( u, ~id ) ▶₀ #j )
          case PrepareUTXO
          solve( Locked( ~id ) ▶₁ #j )
            case PrepareUTXO
            by contradiction /* cyclic */
          qed
        next
          case Reassign
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Transfer
          by solve( Locked( ~id ) ▶₁ #j )
        qed
      qed
    qed
  next
    case Reassign
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( ApprovedTransfer( ~id, Carol ) ▶₂ #i )
        case CommitteeApproval
        solve( !Owner( u, ~id ) ▶₀ #j )
          case PrepareUTXO
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Reassign
          solve( Locked( ~id ) ▶₁ #j )
            case PrepareUTXO
            by contradiction /* cyclic */
          qed
        next
          case Transfer
          by solve( Locked( ~id ) ▶₁ #j )
        qed
      qed
    qed
  next
    case Transfer
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( ApprovedTransfer( ~id, Bob ) ▶₂ #i )
        case CommitteeApproval
        solve( !Owner( u, ~id ) ▶₀ #j )
          case PrepareUTXO
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Reassign
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Transfer
          solve( Locked( ~id ) ▶₁ #j )
            case PrepareUTXO
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !Owner( u, utxo ) ▶₀ #i )
    case PrepareUTXO
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( ApprovedTransfer( ~id, Alice ) ▶₂ #i )
        case CommitteeApproval
        solve( !Owner( u, ~id ) ▶₀ #j )
          case PrepareUTXO
          solve( Locked( ~id ) ▶₁ #j )
            case PrepareUTXO
            by contradiction /* cyclic */
          qed
        next
          case Reassign
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Transfer
          by solve( Locked( ~id ) ▶₁ #j )
        qed
      qed
    qed
  next
    case Reassign
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( ApprovedTransfer( ~id, Carol ) ▶₂ #i )
        case CommitteeApproval
        solve( !Owner( u, ~id ) ▶₀ #j )
          case PrepareUTXO
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Reassign
          solve( Locked( ~id ) ▶₁ #j )
            case PrepareUTXO
            by contradiction /* cyclic */
          qed
        next
          case Transfer
          by solve( Locked( ~id ) ▶₁ #j )
        qed
      qed
    qed
  next
    case Transfer
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( ApprovedTransfer( ~id, Bob ) ▶₂ #i )
        case CommitteeApproval
        solve( !Owner( u, ~id ) ▶₀ #j )
          case PrepareUTXO
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Reassign
          by solve( Locked( ~id ) ▶₁ #j )
        next
          case Transfer
          solve( Locked( ~id ) ▶₁ #j )
            case PrepareUTXO
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
qed

lemma OwnershipTransfer:
  all-traces
  "∀ sender receiver u #i.
    (Transferred( sender, receiver, u ) @ #i) ⇒
    (∃ sig. HasTweakedSig( receiver, sig ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ sender receiver u #i.
  (Transferred( sender, receiver, u ) @ #i)
 ∧
  ∀ sig. (HasTweakedSig( receiver, sig ) @ #i) ⇒ ⊥"
*/
simplify
solve( Transferred( sender, receiver, u ) @ #i )
  case Reassign
  by contradiction /* from formulas */
next
  case Transfer
  by contradiction /* from formulas */
qed

lemma SpendAuthorization:
  all-traces
  "∀ a b id #i.
    (Transferred( a, b, id ) @ #i) ⇒
    (∃ twe. HasTweakedSig( b, twe ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ a b id #i.
  (Transferred( a, b, id ) @ #i)
 ∧
  ∀ twe. (HasTweakedSig( b, twe ) @ #i) ⇒ ⊥"
*/
simplify
solve( Transferred( a, b, id ) @ #i )
  case Reassign
  by contradiction /* from formulas */
next
  case Transfer
  by contradiction /* from formulas */
qed

lemma OwnershipSoundness:
  all-traces
  "∀ sig #i.
    (ValidSignature( sig ) @ #i) ⇒ (∃ u #j. HasTweakSecret( u ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ sig #i.
  (ValidSignature( sig ) @ #i)
 ∧
  ∀ u #j. (HasTweakSecret( u ) @ #j) ⇒ ⊥"
*/
simplify
solve( ValidSignature( sig ) @ #i )
  case Reassign
  by contradiction /* from formulas */
next
  case Transfer
  by contradiction /* from formulas */
qed

lemma Unforgeability:
  all-traces
  "∀ sig #i.
    (ValidSignature( sig ) @ #i) ⇒
    (∃ u #j #k.
      (TweakedSig( u, sig ) @ #j) ∧ (HasTweakSecret( u ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ sig #i.
  (ValidSignature( sig ) @ #i)
 ∧
  ∀ u #j #k.
   (TweakedSig( u, sig ) @ #j) ∧ (HasTweakSecret( u ) @ #k) ⇒ ⊥"
*/
simplify
solve( ValidSignature( sig ) @ #i )
  case Reassign
  by contradiction /* from formulas */
next
  case Transfer
  by contradiction /* from formulas */
qed

lemma CommitteeAuthorizationRequired:
  all-traces
  "∀ id u #i.
    (TransferFinalized( u, id ) @ #i) ⇒
    (∃ #j. (#j < #i) ∧ (CommitteeApproved( id, u ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ id u #i.
  (TransferFinalized( u, id ) @ #i)
 ∧
  ∀ #j. (CommitteeApproved( id, u ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !Owner( u, id ) ▶₀ #i )
  case PrepareUTXO
  solve( Locked( ~id ) ▶₁ #i )
    case PrepareUTXO
    solve( ApprovedTransfer( ~id, Alice ) ▶₂ #i )
      case CommitteeApproval
      by contradiction /* from formulas */
    qed
  qed
next
  case Reassign
  solve( Locked( ~id ) ▶₁ #i )
    case PrepareUTXO
    solve( ApprovedTransfer( ~id, Carol ) ▶₂ #i )
      case CommitteeApproval
      by contradiction /* from formulas */
    qed
  qed
next
  case Transfer
  solve( Locked( ~id ) ▶₁ #i )
    case PrepareUTXO
    solve( ApprovedTransfer( ~id, Bob ) ▶₂ #i )
      case CommitteeApproval
      by contradiction /* from formulas */
    qed
  qed
qed

lemma canFinalize:
  exists-trace
  "∃ id #i #j #k #l.
    ((((((Prepared( id ) @ #i) ∧
         (TransferEvent( Alice, Bob, id ) @ #j)) ∧
        (CommitteeApproved( id, Bob ) @ #k)) ∧
       (Finalized( id ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ id #i #j #k #l.
  (Prepared( id ) @ #i) ∧
  (TransferEvent( Alice, Bob, id ) @ #j) ∧
  (CommitteeApproved( id, Bob ) @ #k) ∧
  (Finalized( id ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
simplify
solve( !Committee( committee ) ▶₀ #k )
  case SetupThunderbolt
  solve( !UTXO( ~id ) ▶₁ #k )
    case PrepareUTXO
    solve( PendingApproval( ~id, Bob ) ▶₂ #k )
      case Transfer
      solve( !Owner( u, ~id ) ▶₀ #l )
        case PrepareUTXO
        solve( Locked( ~id ) ▶₁ #l )
          case PrepareUTXO
          solve( ApprovedTransfer( ~id, Alice ) ▶₂ #l )
            case CommitteeApproval
            solve( TransferEvent( Alice, Bob, ~id ) @ #j )
              case Transfer
              solve( !Owner( Alice, ~id ) ▶₀ #j )
                case PrepareUTXO
                solve( !TweakFor( Alice, Bob, tAB ) ▶₁ #j )
                  case GenerateTweaks
                  solve( !TweakFor( Cmte, Bob, tKB ) ▶₂ #j )
                    case GenerateTweaks
                    solve( !UTXO( ~id ) ▶₄ #j )
                      case PrepareUTXO
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case Reassign
        solve( Locked( ~id ) ▶₁ #l )
          case PrepareUTXO
          solve( ApprovedTransfer( ~id, Carol ) ▶₂ #l )
            case CommitteeApproval
            solve( TransferEvent( Alice, Bob, ~id ) @ #j )
              case Transfer
              solve( !Owner( Alice, ~id ) ▶₀ #j )
                case PrepareUTXO
                solve( !TweakFor( Alice, Bob, tAB ) ▶₁ #j )
                  case GenerateTweaks
                  solve( !TweakFor( Cmte, Bob, tKB ) ▶₂ #j )
                    case GenerateTweaks
                    solve( !UTXO( ~id ) ▶₄ #j )
                      case PrepareUTXO
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case Transfer
        solve( Locked( ~id ) ▶₁ #l )
          case PrepareUTXO
          solve( ApprovedTransfer( ~id, Bob ) ▶₂ #l )
            case CommitteeApproval
            solve( TransferEvent( Alice, Bob, ~id ) @ #j )
              case Transfer
              solve( !Owner( Alice, ~id ) ▶₀ #j )
                case PrepareUTXO
                solve( !TweakFor( Alice, Bob, tAB ) ▶₁ #j )
                  case GenerateTweaks
                  solve( !TweakFor( Cmte, Bob, tKB ) ▶₂ #j )
                    case GenerateTweaks
                    solve( !UTXO( ~id ) ▶₄ #j )
                      case PrepareUTXO
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

