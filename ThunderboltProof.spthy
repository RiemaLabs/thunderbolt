theory Thunderbolt begin

// Function signature and definition of the equational theory E

functions: Alice/0, ApprovedTransfer/2, Bob/0, Carol/0, Cmte/0,
           CommitteeApproved/2, FinalizationSuccess/1, Finalized/1,
           HasTweakSecret/1, Locked/1, OwnerState/3, Prepared/1,
           SetupCommittee/0, Spent/1, TransferEvent/3, TransferFinalized/2,
           TweakFor/3, TweakedSig/2, UTXO/1, ValidSignature/1, adec/2, aenc/2,
           fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true











rule (modulo E) SetupThunderbolt:
   [ Fr( ~committee ) ]
  --[ SetupCommittee( ) ]->
   [ !Committee( ~committee ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) PrepareUTXO:
   [ Fr( ~id ) ]
  --[ Prepared( ~id ) ]->
   [ Locked( ~id ), !OwnerState( Alice, ~id, 'Pending' ), !UTXO( ~id )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenerateTweaks:
   [ Fr( ~tAB ), Fr( ~tKB ), Fr( ~tBC ), Fr( ~tKC ) ]
  -->
   [
   !TweakFor( Alice, Bob, ~tAB ), !TweakFor( Cmte, Bob, ~tKB ),
   !TweakFor( Bob, Carol, ~tBC ), !TweakFor( Cmte, Carol, ~tKC )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Transfer:
   [
   !OwnerState( sender, id, 'Approved' ),
   !TweakFor( sender, receiver, t_sr ),
   !TweakFor( Cmte, receiver, t_cr ), Fr( ~sig ), !UTXO( id )
   ]
  --[
  TransferEvent( sender, receiver, id ),
  TweakedSig( receiver, ~sig ), ValidSignature( ~sig ),
  HasTweakSecret( receiver )
  ]->
   [ !OwnerState( receiver, id, 'Pending' ), Out( <receiver, ~sig> ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) CommitteeApproval:
   [
   !Committee( committee ), !UTXO( id ),
   !OwnerState( u, id, 'Pending' ), Fr( ~approval )
   ]
  --[ CommitteeApproved( id, u ) ]->
   [ !OwnerState( u, id, 'Approved' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Finalize:
   [ !OwnerState( u, id, 'Approved' ), Locked( id ) ]
  --[
  Finalized( id ), FinalizationSuccess( id ),
  TransferFinalized( u, id )
  ]->
   [ Spent( id ) ]

  /* has exactly the trivial AC variant */

lemma OneTimeSpendability:
  all-traces
  "∀ utxo #i #j.
    ((Finalized( utxo ) @ #i) ∧ (Finalized( utxo ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ utxo #i #j.
  (Finalized( utxo ) @ #i) ∧ (Finalized( utxo ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !OwnerState( u, utxo, 'Approved' ) ▶₀ #i )
    case CommitteeApproval_case_1
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_2
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_3
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_4
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_5
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !OwnerState( u, utxo, 'Approved' ) ▶₀ #i )
    case CommitteeApproval_case_1
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_2
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_3
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_4
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      next
        case CommitteeApproval_case_5
        by solve( Locked( ~id ) ▶₁ #j )
      qed
    qed
  next
    case CommitteeApproval_case_5
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval_case_1
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_2
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_3
        by solve( Locked( ~id ) ▶₁ #j )
      next
        case CommitteeApproval_case_4
        by solve( Locked( ~id ) ▶₁ #j )
