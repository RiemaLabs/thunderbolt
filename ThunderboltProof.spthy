        case CommitteeApproval_case_5
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma OwnershipTransfer:
  all-traces
  "∀ sender receiver id #i.
    (TransferEvent( sender, receiver, id ) @ #i) ⇒
    (∃ sig. TweakedSig( receiver, sig ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ sender receiver id #i.
  (TransferEvent( sender, receiver, id ) @ #i)
 ∧
  ∀ sig. (TweakedSig( receiver, sig ) @ #i) ⇒ ⊥"
*/
simplify
by contradiction /* from formulas */

lemma OwnershipSoundness:
  all-traces
  "∀ sig #i.
    (ValidSignature( sig ) @ #i) ⇒ (∃ u #j. HasTweakSecret( u ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ sig #i.
  (ValidSignature( sig ) @ #i)
 ∧
  ∀ u #j. (HasTweakSecret( u ) @ #j) ⇒ ⊥"
*/
simplify
by contradiction /* from formulas */

lemma Unforgeability:
  all-traces
  "∀ sig #i.
    (ValidSignature( sig ) @ #i) ⇒
    (∃ u #j #k.
      (TweakedSig( u, sig ) @ #j) ∧ (HasTweakSecret( u ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ sig #i.
  (ValidSignature( sig ) @ #i)
 ∧
  ∀ u #j #k.
   (TweakedSig( u, sig ) @ #j) ∧ (HasTweakSecret( u ) @ #k) ⇒ ⊥"
*/
simplify
by contradiction /* from formulas */

lemma CommitteeAuthorizationRequired:
  all-traces
  "∀ id u #i.
    (TransferFinalized( u, id ) @ #i) ⇒
    (∃ #j. (#j < #i) ∧ (CommitteeApproved( id, u ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ id u #i.
  (TransferFinalized( u, id ) @ #i)
 ∧
  ∀ #j. (CommitteeApproved( id, u ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !OwnerState( u, id, 'Approved' ) ▶₀ #i )
  case CommitteeApproval_case_1
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_2
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_3
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_4
  by contradiction /* from formulas */
next
  case CommitteeApproval_case_5
  by contradiction /* from formulas */
qed

lemma canFinalize:
  exists-trace
  "∃ id #i #j #k #l.
    ((((((Prepared( id ) @ #i) ∧
         (TransferEvent( Alice, Bob, id ) @ #j)) ∧
        (CommitteeApproved( id, Bob ) @ #k)) ∧
       (Finalized( id ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ id #i #j #k #l.
  (Prepared( id ) @ #i) ∧
  (TransferEvent( Alice, Bob, id ) @ #j) ∧
  (CommitteeApproved( id, Bob ) @ #k) ∧
  (Finalized( id ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
simplify
solve( !TweakFor( Alice, Bob, t_sr ) ▶₁ #j )
  case GenerateTweaks
  solve( !TweakFor( Cmte, Bob, t_cr ) ▶₂ #j )
    case GenerateTweaks
    solve( !UTXO( ~id ) ▶₄ #j )
      case PrepareUTXO
      solve( !Committee( committee ) ▶₀ #k )
        case SetupThunderbolt
        solve( !UTXO( ~id ) ▶₁ #k )
          case PrepareUTXO
          solve( !OwnerState( Bob, ~id, 'Pending' ) ▶₂ #k )
            case Transfer_case_1
            solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #l )
              case CommitteeApproval_case_1
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    SOLVED // trace found
                  qed
                qed
              qed
            next
              case CommitteeApproval_case_2
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.8 )
                      case CommitteeApproval
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            next
              case CommitteeApproval_case_3
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.8 )
                  qed
                qed
              qed
            next
              case CommitteeApproval_case_4
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    solve( !OwnerState( Bob, ~id, 'Approved' ) ▶₀ #vr.8 )
                      case CommitteeApproval_case_1
                      solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.17 )
                        case CommitteeApproval
                        SOLVED // trace found
                      qed
                    next
                      case CommitteeApproval_case_2
                      by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.17 )
                    qed
                  qed
                qed
              qed
            next
              case CommitteeApproval_case_5
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.3 )
                    case CommitteeApproval
                    by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.8 )
                  qed
                qed
              qed
            qed
          next
            case Transfer_case_2
            solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #l )
              case CommitteeApproval_case_1
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.3 )
                qed
              qed
            next
              case CommitteeApproval_case_2
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.3 )
                qed
              qed
            next
              case CommitteeApproval_case_3
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.3 )
                qed
              qed
            next
              case CommitteeApproval_case_4
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.3 )
                qed
              qed
            next
              case CommitteeApproval_case_5
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #j )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.3 )
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma transferCompletionPossible:
  exists-trace
  "∃ id #i #j #k #l.
    ((((((Prepared( id ) @ #i) ∧
         (CommitteeApproved( id, Alice ) @ #j)) ∧
        (TransferEvent( Alice, Bob, id ) @ #k)) ∧
       (Finalized( id ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ id #i #j #k #l.
  (Prepared( id ) @ #i) ∧
  (CommitteeApproved( id, Alice ) @ #j) ∧
  (TransferEvent( Alice, Bob, id ) @ #k) ∧
  (Finalized( id ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
simplify
solve( !Committee( committee ) ▶₀ #j )
  case SetupThunderbolt
  solve( !UTXO( ~id ) ▶₁ #j )
    case PrepareUTXO
    solve( !OwnerState( Alice, ~id, 'Pending' ) ▶₂ #j )
      case PrepareUTXO
      solve( !TweakFor( Alice, Bob, t_sr ) ▶₁ #k )
        case GenerateTweaks
        solve( !TweakFor( Cmte, Bob, t_cr ) ▶₂ #k )
          case GenerateTweaks
          solve( !UTXO( ~id ) ▶₄ #k )
            case PrepareUTXO
            solve( !OwnerState( u, ~id, 'Approved' ) ▶₀ #l )
              case CommitteeApproval_case_1
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #k )
                  case CommitteeApproval
                  SOLVED // trace found
                qed
              qed
            next
              case CommitteeApproval_case_2
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #k )
                  case CommitteeApproval
                  solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.5 )
                    case CommitteeApproval
                    SOLVED // trace found
                  qed
                qed
              qed
            next
              case CommitteeApproval_case_3
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #k )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.5 )
                qed
              qed
            next
              case CommitteeApproval_case_4
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #k )
                  case CommitteeApproval
                  solve( !OwnerState( Bob, ~id, 'Approved' ) ▶₀ #vr.5 )
                    case CommitteeApproval_case_1
                    solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #vr.12 )
                      case CommitteeApproval
                      SOLVED // trace found
                    qed
                  next
                    case CommitteeApproval_case_2
                    by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.12 )
                  qed
                qed
              qed
            next
              case CommitteeApproval_case_5
              solve( Locked( ~id ) ▶₁ #l )
                case PrepareUTXO
                solve( !OwnerState( Alice, ~id, 'Approved' ) ▶₀ #k )
                  case CommitteeApproval
                  by solve( !OwnerState( Cmte, ~id, 'Approved' ) ▶₀ #vr.5 )
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma finalizationSuccessPossible:
  exists-trace
  "∃ id #i #j #k #l.
    ((((((Prepared( id ) @ #i) ∧
         (TransferEvent( Alice, Bob, id ) @ #j)) ∧
        (CommitteeApproved( id, Bob ) @ #k)) ∧
       (FinalizationSuccess( id ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ id #i #j #k #l.
  (Prepared( id ) @ #i) ∧
  (TransferEvent( Alice, Bob, id ) @ #j) ∧
  (CommitteeApproved( id, Bob ) @ #k) ∧
  (FinalizationSuccess( id ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
simplify
