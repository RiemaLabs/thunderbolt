theory Thunderbolt begin

// Basic cryptographic primitives
builtins: signing, hashing, asymmetric-encryption

// Functions and constants used in the protocol
functions: Alice/0, Bob/0, Carol/0, Cmte/0, 
           FinalizationSuccess/1, Finalized/1,
           Locked/1, Prepared/1, 
           SetupCommittee/0, 
           Spent/1, TransferEvent/4, 
           TweakFor/3, UTXO/1,
           CommitteeApproved/3, TransferFinalized/2,
           ApprovedTransfer/2,
           ValidSignature/1, HasTweakSecret/1, TweakedSig/2,
           OwnerState/3

// Protocol rules
rule SetupThunderbolt:
   [ Fr(~committee) ]
  --[ SetupCommittee() ]->
   [ !Committee(~committee) ]

rule PrepareUTXO:
   [ Fr(~id), Fr(~sender) ]
  --[ Prepared(~id) ]->
   [ Locked(~id), !OwnerState(~sender, ~id, 'Pending'), !UTXO(~id) ]
   
rule GenerateTweaks:
   [ !Committee(~committee), Fr(~t_sr), Fr(~t_cr), !OwnerState(~sender, ~id, 'Pending'), Fr(~receiver)]
  -->
   [ !TweakFor(~sender, ~receiver, ~t_sr),
     !TweakFor(~committee, ~receiver, ~t_cr) ]

rule Transfer:
   [ !Committee(~committee), !OwnerState(~sender, ~id, 'Approved'),
     !TweakFor(~sender, ~receiver, t_sr), !TweakFor(~committee, ~receiver, t_cr),
     Fr(~sig), !UTXO(~id) ]
  --[ TransferEvent(~committee, ~sender, ~receiver, ~id), TweakedSig(~receiver, ~sig),
      ValidSignature(~sig), HasTweakSecret(~receiver) ]->
   [ !OwnerState(~receiver, ~id, 'Pending'), Out(<~receiver, ~sig>) ]

rule CommitteeApproval:
   [ !Committee(~committee), !UTXO(~id), !OwnerState(~u, ~id, 'Pending')]
  --[ CommitteeApproved(~committee, ~id, ~u) ]->
   [ !OwnerState(~u, ~id, 'Approved') ]


// Finalize the transfer with committee approval
rule Finalize:
  [ !OwnerState(~receiver, ~id, 'Approved'), Locked(~id) ]
  --[ Finalized(~id), FinalizationSuccess(~id), TransferFinalized( ~receiver, ~id) ]->
  [ Spent(~id) ]


// Security lemmas

// Ensure that a UTXO can only be spent once
lemma OneTimeSpendability:
  all-traces
  "∀ utxo #i #j.
         ((Finalized( utxo ) @ #i) ∧ (Finalized( utxo ) @ #j)) ⇒
         (#i = #j)"
simplify
solve( (#i < #j) ∥ (#j < #i) )
  case case_1
  solve( !OwnerState( ~receiver, ~id, 'Approved' ) ▶₀ #i )
    case CommitteeApproval
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( ~receiver.1, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !OwnerState( ~receiver, ~id, 'Approved' ) ▶₀ #i )
    case CommitteeApproval
    solve( Locked( ~id ) ▶₁ #i )
      case PrepareUTXO
      solve( !OwnerState( ~receiver.1, ~id, 'Approved' ) ▶₀ #j )
        case CommitteeApproval
        solve( Locked( ~id ) ▶₁ #j )
          case PrepareUTXO
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma OwnershipTransfer:
  all-traces
  "∀ committee sender receiver id #i.
         (TransferEvent( committee, sender, receiver, id ) @ #i) ⇒
         (∃ sig. TweakedSig( receiver, sig ) @ #i)"
simplify
by contradiction /* from formulas */

lemma OwnershipSoundness:
  all-traces
  "∀ sig #i.
         (ValidSignature( sig ) @ #i) ⇒
         (∃ u #j. HasTweakSecret( u ) @ #j)"
simplify
by contradiction /* from formulas */

lemma Unforgeability:
  all-traces
  "∀ sig #i.
         (ValidSignature( sig ) @ #i) ⇒
         (∃ u #j #k.
           (TweakedSig( u, sig ) @ #j) ∧ (HasTweakSecret( u ) @ #k))"
simplify
by contradiction /* from formulas */

lemma CommitteeAuthorizationRequired:
  all-traces
  "∀ id u #i.
         (TransferFinalized( u, id ) @ #i) ⇒
         (∃ #j committee.
           (#j < #i) ∧ (CommitteeApproved( committee, id, u ) @ #j))"
simplify
solve( !OwnerState( ~receiver, ~id, 'Approved' ) ▶₀ #i )
  case CommitteeApproval
  by contradiction /* from formulas */
qed

lemma canFinalize:
  exists-trace
  "∃ id committee sender receiver #i #ij #j #k #l.
         ((((((((Prepared( id ) @ #i) ∧
                (CommitteeApproved( committee, id, sender ) @ #ij)) ∧
               (TransferEvent( committee, sender, receiver, id ) @ #j)) ∧
              (CommitteeApproved( committee, id, receiver ) @ #k)) ∧
             (Finalized( id ) @ #l)) ∧
            (#i < #ij)) ∧
           (#ij < #j)) ∧
          (#j < #k)) ∧
         (#k < #l)"
simplify
solve( !Committee( ~committee ) ▶₀ #ij )
  case SetupThunderbolt
  solve( !UTXO( ~id ) ▶₁ #ij )
    case PrepareUTXO
    solve( !Committee( ~committee ) ▶₀ #j )
      case SetupThunderbolt
      solve( !OwnerState( ~u, ~id, 'Approved' ) ▶₁ #j )
        case CommitteeApproval
        solve( !UTXO( ~id ) ▶₅ #j )
          case PrepareUTXO
          solve( !Committee( ~committee ) ▶₀ #k )
            case SetupThunderbolt
            solve( !UTXO( ~id ) ▶₁ #k )
              case PrepareUTXO
              solve( !OwnerState( ~receiver.1, ~id, 'Approved' ) ▶₀ #l )
                case CommitteeApproval
                solve( Locked( ~id ) ▶₁ #l )
                  case PrepareUTXO
                  solve( !OwnerState( ~u, ~id, 'Pending' ) ▶₂ #ij )
                    case PrepareUTXO
                    solve( !TweakFor( ~sender, ~receiver, t_sr ) ▶₂ #j )
                      case GenerateTweaks_case_1
                      solve( !TweakFor( ~committee, ~receiver, t_cr ) ▶₃ #j )
                        case GenerateTweaks
                        solve( !OwnerState( ~receiver, ~id, 'Pending' ) ▶₂ #k )
                          case Transfer
                          solve( !OwnerState( ~sender, ~id, 'Pending' ) ▶₂ #vr.1 )
                            case PrepareUTXO
                            solve( !OwnerState( ~receiver.1, ~id, 'Pending'
                                   ) ▶₂ #vr.3 )
                              case PrepareUTXO
                              solve( !TweakFor( ~sender.1, ~receiver, t_sr.1 ) ▶₂ #vr.6 )
                                case GenerateTweaks_case_1
                                solve( !TweakFor( ~committee.3, ~receiver, t_cr.1 ) ▶₃ #vr.6 )
                                  case GenerateTweaks
                                  solve( !OwnerState( ~sender, ~id, 'Pending' ) ▶₂ #vr.7 )
                                    case PrepareUTXO
                                    SOLVED // trace found
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma transferCompletionPossible:
  exists-trace
  "∃ id committee sender receiver #i #j #k #l.
         ((((((Prepared( id ) @ #i) ∧
              (CommitteeApproved( committee, id, sender ) @ #j)) ∧
             (TransferEvent( committee, sender, receiver, id ) @ #k)) ∧
            (Finalized( id ) @ #l)) ∧
           (#i < #j)) ∧
          (#j < #k)) ∧
         (#k < #l)"
simplify
solve( !Committee( ~committee ) ▶₀ #j )
  case SetupThunderbolt
  solve( !UTXO( ~id ) ▶₁ #j )
    case PrepareUTXO
    solve( !Committee( ~committee ) ▶₀ #k )
      case SetupThunderbolt
      solve( !OwnerState( ~u, ~id, 'Approved' ) ▶₁ #k )
        case CommitteeApproval
        solve( !UTXO( ~id ) ▶₅ #k )
          case PrepareUTXO
          solve( !OwnerState( ~receiver.1, ~id, 'Approved' ) ▶₀ #l )
            case CommitteeApproval
            solve( Locked( ~id ) ▶₁ #l )
              case PrepareUTXO
              solve( !OwnerState( ~u, ~id, 'Pending' ) ▶₂ #j )
                case PrepareUTXO
                solve( !TweakFor( ~sender, ~receiver, t_sr ) ▶₂ #k )
                  case GenerateTweaks_case_1
                  solve( !TweakFor( ~committee, ~receiver, t_cr ) ▶₃ #k )
                    case GenerateTweaks
                    solve( !OwnerState( ~sender, ~id, 'Pending' ) ▶₂ #vr.1 )
                      case PrepareUTXO
                      solve( !OwnerState( ~receiver.1, ~id, 'Pending'
                             ) ▶₂ #vr.3 )
                        case PrepareUTXO
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma finalizationSuccessPossible:
  exists-trace
  "∃ id committee sender receiver #i #j #k #l.
         ((((((Prepared( id ) @ #i) ∧
              (TransferEvent( committee, sender, receiver, id ) @ #j)) ∧
             (CommitteeApproved( committee, id, receiver ) @ #k)) ∧
            (FinalizationSuccess( id ) @ #l)) ∧
           (#i < #j)) ∧
          (#j < #k)) ∧
         (#k < #l)"
simplify
solve( !Committee( ~committee ) ▶₀ #j )
  case SetupThunderbolt
  solve( !OwnerState( ~sender.1, ~id, 'Approved' ) ▶₁ #j )
    case CommitteeApproval
    solve( !UTXO( ~id ) ▶₅ #j )
      case PrepareUTXO
      solve( !Committee( ~committee ) ▶₀ #k )
        case SetupThunderbolt
        solve( !UTXO( ~id ) ▶₁ #k )
          case PrepareUTXO
          solve( !OwnerState( ~receiver.1, ~id, 'Approved' ) ▶₀ #l )
            case CommitteeApproval
            solve( Locked( ~id ) ▶₁ #l )
              case PrepareUTXO
              solve( !TweakFor( ~sender.1, ~receiver, t_sr ) ▶₂ #j )
                case GenerateTweaks_case_1
                solve( !TweakFor( ~committee, ~receiver, t_cr ) ▶₃ #j )
                  case GenerateTweaks
                  solve( !OwnerState( ~receiver, ~id, 'Pending' ) ▶₂ #k )
                    case Transfer
                    solve( !OwnerState( ~sender.1, ~id, 'Pending' ) ▶₂ #vr.1 )
                      case PrepareUTXO
                      solve( !OwnerState( ~receiver.1, ~id, 'Pending'
                             ) ▶₂ #vr.3 )
                        case PrepareUTXO
                        solve( !TweakFor( ~sender.1, ~receiver, t_sr.1 ) ▶₂ #vr.6 )
                          case GenerateTweaks_case_1
                          solve( !TweakFor( ~committee.3, ~receiver, t_cr.1 ) ▶₃ #vr.6 )
                            case GenerateTweaks
                            solve( !OwnerState( ~sender, ~id, 'Pending' ) ▶₂ #vr.7 )
                              case PrepareUTXO
                              SOLVED // trace found
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

end